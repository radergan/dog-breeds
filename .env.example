# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here-DO-NOT-COMMIT

# Petfinder API Configuration
# Get your API keys at: https://www.petfinder.com/developers/
PETFINDER_API_KEY=your-api-key-here
PETFINDER_API_SECRET=your-api-secret-here

# Amazon Product Advertising API Configuration
# Get your credentials at: https://affiliate-program.amazon.com/assoc_credentials/home
AMAZON_ACCESS_KEY=your-access-key-here
AMAZON_SECRET_KEY=your-secret-key-here

# Amazon Associate IDs (your affiliate tags)
# Sign up at: https://affiliate-program.amazon.com/
AMAZON_ASSOCIATE_TAG_US=your-tag-20
AMAZON_ASSOCIATE_TAG_UK=your-tag-21
AMAZON_ASSOCIATE_TAG_CA=your-tag-22

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 3. Never commit the .env file to git
